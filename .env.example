# Database
DATABASE_URL=postgresql+asyncpg://pulsewatch:password@localhost:5432/pulsewatch
DATABASE_TEST_URL=postgresql+asyncpg://pulsewatch:password@localhost:5433/pulsewatch_test

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
DEBUG=false
LOG_LEVEL=INFO

# Telegram (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Worker
WORKER_ENABLED=true
CHECK_TIMEOUT_SECONDS=10
INCIDENT_THRESHOLD=3
HISTORY_RETENTION_DAYS=30
HISTORY_PRUNE_INTERVAL_SECONDS=3600

# SSRF: extra CIDR ranges to block (comma separated), e.g. "198.18.0.0/15,10.0.0.0/8"
SSRF_BLOCKED_NETWORKS=

# API
API_HOST=0.0.0.0
API_PORT=8000
